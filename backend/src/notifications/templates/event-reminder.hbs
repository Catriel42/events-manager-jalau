<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Event Reminder</title>
</head>
<body style="margin:0;padding:0;background-color:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f8fafc;padding:48px 0;width:100%;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.05);border:1px solid #e2e8f0;width:600px;max-width:600px;">
          <!-- Header Banner -->
          <tr>
            <td style="padding:0;margin:0;">
              <img src="{{frontendUrl}}/banner_cropped.png" alt="Jala University Events" width="600" style="display:block;width:100%;max-width:600px;height:auto;border:0;margin:0;" />
            </td>
          </tr>
          <!-- Body Content -->
          <tr>
            <td style="padding:40px 32px;">
              {{#if isOneHour}}
                <h1 style="margin:0 0 12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;color:#0f172a;">Starting in 1 hour</h1>
                <p style="margin:0 0 28px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;color:#475569;">
                  Hi <strong>{{name}}</strong>,<br><br>
                  This is a quick reminder that <a href="{{eventUrl}}" style="color:#004dff;text-decoration:none;font-weight:700;">{{eventTitle}}</a> starts in about <strong>1 hour</strong>. Get your setup ready!
                </p>
              {{else}}
                <h1 style="margin:0 0 12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;color:#0f172a;">Happening tomorrow</h1>
                <p style="margin:0 0 28px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;color:#475569;">
                  Hi <strong>{{name}}</strong>,<br><br>
                  This is a friendly reminder that <a href="{{eventUrl}}" style="color:#004dff;text-decoration:none;font-weight:700;">{{eventTitle}}</a> is scheduled for <strong>tomorrow</strong>.
                </p>
              {{/if}}

              <!-- Event Details Card -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:28px;width:100%;">
                <tr>
                  <td style="padding:24px;">
                    <span style="background-color:rgba(0,77,255,0.08);color:#004dff;padding:4px 10px;border-radius:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;display:inline-block;margin-bottom:20px;">
                      Event Details
                    </span>
                    
                    <table width="100%" cellpadding="0" cellspacing="0" style="width:100%;">
                      <!-- Date Row -->
                      <tr>
                        <td style="padding-bottom:14px;vertical-align:middle;">
                          <table cellpadding="0" cellspacing="0">
                            <tr>
                              <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;color:#004dff;text-transform:uppercase;letter-spacing:0.05em;background-color:rgba(0,77,255,0.08);padding:4px 8px;border-radius:6px;text-align:center;width:75px;display:inline-block;">
                                Date
                              </td>
                              <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;color:#1e293b;padding-left:16px;">
                                {{eventDate}}
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                      <!-- Time Row -->
                      <tr>
                        <td style="padding-bottom:14px;vertical-align:middle;">
                          <table cellpadding="0" cellspacing="0">
                            <tr>
                              <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;color:#004dff;text-transform:uppercase;letter-spacing:0.05em;background-color:rgba(0,77,255,0.08);padding:4px 8px;border-radius:6px;text-align:center;width:75px;display:inline-block;">
                                Time
                              </td>
                              <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;color:#1e293b;padding-left:16px;">
                                {{eventTime}}
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                      <!-- Location Row -->
                      <tr>
                        <td style="vertical-align:middle;">
                          <table cellpadding="0" cellspacing="0">
                            <tr>
                              <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;color:#004dff;text-transform:uppercase;letter-spacing:0.05em;background-color:rgba(0,77,255,0.08);padding:4px 8px;border-radius:6px;text-align:center;width:75px;display:inline-block;">
                                {{#if isVirtual}}Link{{else}}Location{{/if}}
                              </td>
                              <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;color:#1e293b;padding-left:16px;">
                                {{#if isVirtual}}
                                  <a href="{{location}}" style="color:#004dff;text-decoration:none;font-weight:600;">Join Virtual Event</a>
                                {{else}}
                                  {{location}}
                                {{/if}}
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Cancellation Link (Plomo / Gray) -->
              <p style="margin:24px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#64748b;text-align:center;line-height:20px;">
                Changed your mind? You can <a href="{{eventUrl}}" target="_blank" style="color:#64748b;text-decoration:underline;font-weight:600;">cancel your registration</a>.
              </p>
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="padding:24px 32px;background-color:#f8fafc;border-top:1px solid #e2e8f0;text-align:center;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:#94a3b8;line-height:18px;">
              <p style="margin:0 0 6px;">Jala University Events Manager — Empowering Education</p>
              <p style="margin:0;">This is an automated notification regarding your registration. Please do not reply directly to this email.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
