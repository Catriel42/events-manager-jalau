# Database
DATABASE_URL="postgresql://user:password@localhost:5432/eventmanager_dev?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/eventmanager_dev?schema=public"

# Authentication - Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Authentication - Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# JWT
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRATION=7d

# App Configuration
FRONTEND_URL=http://localhost:4200
PORT=3000

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Emails (Resend SMTP Configuration)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
MAIL_PASS=your-resend-api-key
MAIL_FROM="Events Manager <noreply@example.com>"

# Redis Configuration (For Caching & Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=